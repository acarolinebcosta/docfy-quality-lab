# URL da instância do Docfy usada pelos testes black-box.
DOCFY_API_BASE_URL=http://localhost:8080

# Senha definida em DOCFY_DEV_SEED_PASSWORD ao iniciar o backend do Docfy.
# Nunca versione uma senha real.
DOCFY_TEST_PASSWORD=change-me-locally

# Timeout de cada requisição HTTP, em milissegundos.
DOCFY_HTTP_TIMEOUT_MS=10000
