{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Docfy API error response",
  "type": "object",
  "required": ["timestamp", "status", "error", "message", "path", "correlationId"],
  "properties": {
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "error": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string"
    },
    "path": {
      "type": "string",
      "pattern": "^/"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
